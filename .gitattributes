# ------------------------------------------------------------------ #
#  Line-ending rules (FUNCTIONAL - these affect how files execute).   #
#  Kept regardless of the language-bar settings below.                #
# ------------------------------------------------------------------ #
*.sh text eol=lf
*.bat text eol=crlf
*.py text
*.md text
native/*.c text eol=lf
native/*.cpp text eol=lf
native/*.h text eol=lf
*.png binary
*.ico binary

# ------------------------------------------------------------------ #
#  Compiled native artifacts: never language-statistics material.    #
# ------------------------------------------------------------------ #
native/dtk linguist-vendored=true
native/dtk.exe linguist-vendored=true
native/dufast linguist-vendored=true
native/dufast.exe linguist-vendored=true
*.exe linguist-vendored=true
*.dll linguist-vendored=true

# ------------------------------------------------------------------ #
#  GitHub "Languages" bar - repository owner's display preference.   #
#                                                                    #
#  DiskTop's runtime is Python and it ships a large C++ core (dtk),  #
#  but the owner wants NEITHER Python NOR C++ presented as the        #
#  primary language. Only the hand-written C helper (native/dufast.c) #
#  is left as the featured/detectable language, so the bar reads "C". #
#                                                                    #
#  linguist-detectable=false changes ONLY the statistics display: it  #
#  never deletes a file, never stops the C++/Python code from running,#
#  and never affects the test suite or the built .exe.               #
# ------------------------------------------------------------------ #
*.py linguist-detectable=false
tests/* linguist-vendored=true
*.cpp linguist-detectable=false
*.h linguist-detectable=false
*.md linguist-detectable=false
*.bat linguist-detectable=false
*.sh linguist-detectable=false
*.yml linguist-detectable=false
*.yaml linguist-detectable=false
*.spec linguist-detectable=false
*.txt linguist-detectable=false

# The C helper is the single featured language of the repository.
native/dufast.c linguist-detectable=true
*.c linguist-detectable=true
